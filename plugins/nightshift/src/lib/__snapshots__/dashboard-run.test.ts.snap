  <ol class="dec"><li style="padding-left:14px" class="t-neutral">No decisions pending.
      <span class="d-src">from digest · generated 2026-08-23 06:14</span></li></ol>
  <style>.dec li:only-child::before{display:none}</style>
</section>

<section class="blk">
  <h2>Coverage</h2>

  <article class="repo" id="quillbase">
    <div class="repo-hd"><h3>quillbase</h3>
