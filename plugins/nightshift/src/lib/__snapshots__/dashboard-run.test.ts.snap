        <th scope="row" class="area"><code>app/Http/Controllers/Account*</code></th>
        <td class="id"><code>QB-SEC-01</code></td>
        <td class="wt">critical</td>
        <td class="cov"><span class="pill p-neutral">
          <span class="g" aria-hidden="true">◇</span>not yet reviewed</span></td>
        <td class="when"><span class="ago">never</span></td>
        <td class="find"><span class="none">—</span></td>
      </tr><tr class="c-never">
        <th scope="row" class="area"><code>app/Services/Billing/*</code></th>
        <td class="id"><code>QB-SEC-02</code></td>
        <td class="wt">critical</td>
        <td class="cov"><span class="pill p-neutral">
          <span class="g" aria-hidden="true">◇</span>not yet reviewed</span></td>
        <td class="when"><span class="ago">never</span></td>
        <td class="find"><span class="none">—</span></td>
      </tr><tr class="c-never">
        <th scope="row" class="area"><code>app/Http/Middleware/*</code></th>
        <td class="id"><code>QB-SEC-03</code></td>
        <td class="wt">high</td>
        <td class="cov"><span class="pill p-neutral">
          <span class="g" aria-hidden="true">◇</span>not yet reviewed</span></td>
        <td class="when"><span class="ago">never</span></td>
        <td class="find"><span class="none">—</span></td>
      </tr>
      </tbody>
    </table>
    </div>
  </div>
    <div class="lane"><h4>design lane</h4>
      <p class="lane-off">Enabled in <code>config.yml</code>, but the pack is not ready: <code>fixtures/personas.yml</code> is missing and <code>stack_adapter.browser.base_url</code> is unset. <code>ns</code> will refuse this lane until both exist.</p></div>
  </article>
</section>

<section class="blk">
  <h2>Trends</h2>
  <div class="trends">
    <div class="tr">
  <div class="tr-hd"><span class="tr-name">Coverage freshness</span><span class="tr-goal">higher is better</span></div>
  <div class="spark-wrap"><span class="spark-none">no data</span></div><p class="tr-sub">Starts after the first run.</p></div>
    <div class="tr">
  <div class="tr-hd"><span class="tr-name">False-positive rate (7d)</span><span class="tr-goal">lower is better</span></div>
  <div class="spark-wrap"><span class="spark-none">no data</span></div><p class="tr-sub">Starts after the first run.</p></div>
    <div class="tr">
  <div class="tr-hd"><span class="tr-name">Cost per run</span><span class="tr-goal">lower is better</span></div>
  <div class="spark-wrap"><span class="spark-none">no data</span></div><p class="tr-sub">Starts after the first run.</p></div>
  </div>
</section>

<section class="blk" id="hygiene">
  <h2>Hygiene</h2>
  <div class="hyg">
    <strong class="t-ok">✓ Nothing to clean up</strong>
    <ul><li class="ok">No runs yet.</li></ul>
  </div>
</section>

<footer>
  <span>Generated 2026-08-23 09:02 by <code>bin/dashboard</code> · nightshift 3.0.0-dev · disposable projection, never committed</span>
  <span>Cost: no runs recorded</span>
</footer></div></body></html>"
